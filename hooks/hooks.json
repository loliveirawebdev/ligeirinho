{
  "description": "Ligeirinho: carrega o fluxo, roda testes antes do commit, mantém views puras e exige gate e nota no fechamento. Só age em repositórios com .ligeirinho.yml.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inicio-de-sessao.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/antes-do-commit.sh\"", "timeout": 900 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/view-pura.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/fim-de-sessao.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
