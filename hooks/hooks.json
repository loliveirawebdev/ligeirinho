{
  "description": "Ligeirinho (Claude Code and Codex): loads the flow, runs tests before commits, keeps views pure, and requires a green gate and a feature note to close. Only acts in repositories with .ligeirinho.yml.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/before-commit.sh\"", "timeout": 900 } ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pure-view.sh\"", "timeout": 10 } ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop.sh\"", "timeout": 10 } ] }
    ]
  }
}
