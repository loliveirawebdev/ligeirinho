{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "declaration": false,
    "outDir": "../dist/out-tsc-demo",
    "paths": {
