{
  "name": "@ligeirinho/bruno-tools",
  "version": "0.1.4",
  "description": "Keeps a Bruno collection in sync with an OpenAPI document: drift check, local environment writer and request scaffolding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loliveirawebdev/ligeirinho.git",
    "directory": "packages/bruno-tools"
  },
  "homepage": "https://github.com/loliveirawebdev/ligeirinho/tree/main/packages/bruno-tools#readme",
  "type": "module",
  "bin": {
    "ligeirinho-bruno": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
