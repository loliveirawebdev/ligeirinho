{
  "name": "@ligeirinho/jscpd-config",
  "version": "0.1.0",
  "description": "Shared jscpd config and a CLI that fails on any copy-paste and on any jscpd ignore without a reason.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jscpd.json": "./jscpd.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ligeirinho-jscpd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "jscpd.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "dependencies": {
    "jscpd": "4.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
