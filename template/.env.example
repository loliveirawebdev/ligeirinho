# Copied to .env by `make up` (TOKEN_SECRET is generated). .env is ignored by git: real secrets never go in it.
DATABASE_URL=postgresql://app_user:app_user@db:5432/app
MIGRATION_DATABASE_URL=postgresql://migrator:migrator@db:5432/app
TEST_DATABASE_URL=postgresql://app_user:app_user@db-test:5432/app
TEST_MIGRATION_DATABASE_URL=postgresql://migrator:migrator@db-test:5432/app
WEB_ORIGIN=http://localhost:4200
TOKEN_SECRET=
TOKEN_ISSUER=app-local
TOKEN_AUDIENCE=app-api
# Change these in a second worktree so two stacks can run side by side.
API_PORT=3000
WEB_PORT=4200
